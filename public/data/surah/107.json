{"n":107,"verses":[{"n":1,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","fr":"Vois-tu celui qui traite de mensonge la Rétribution?","juz":30,"q":240,"page":602,"sajda":0},{"n":2,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","fr":"C'est bien lui qui repousse l'orphelin,","juz":30,"q":240,"page":602,"sajda":0},{"n":3,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","fr":"et qui n'encourage point à nourrir le pauvre.","juz":30,"q":240,"page":602,"sajda":0},{"n":4,"ar":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","fr":"Malheur donc, à ceux qui prient","juz":30,"q":240,"page":602,"sajda":0},{"n":5,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","fr":"tout en négligeant (et retardant) leur Salât,","juz":30,"q":240,"page":602,"sajda":0},{"n":6,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","fr":"qui sont pleins d'ostentation,","juz":30,"q":240,"page":602,"sajda":0},{"n":7,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","fr":"et refusent l'ustensile (à celui qui en a besoin).","juz":30,"q":240,"page":602,"sajda":0}]}