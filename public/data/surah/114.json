{"n":114,"verses":[{"n":1,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","fr":"Dis: «Je cherche protection auprès du Seigneur des hommes.","juz":30,"q":240,"page":604,"sajda":0},{"n":2,"ar":"مَلِكِ ٱلنَّاسِ","fr":"Le Souverain des hommes,","juz":30,"q":240,"page":604,"sajda":0},{"n":3,"ar":"إِلَٰهِ ٱلنَّاسِ","fr":"Dieu des hommes,","juz":30,"q":240,"page":604,"sajda":0},{"n":4,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","fr":"contre le mal du mauvais conseiller, furtif,","juz":30,"q":240,"page":604,"sajda":0},{"n":5,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","fr":"qui souffle le mal dans les poitrines des hommes,","juz":30,"q":240,"page":604,"sajda":0},{"n":6,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","fr":"qu'il (le conseiller) soit un djinn, ou un être humain».","juz":30,"q":240,"page":604,"sajda":0}]}