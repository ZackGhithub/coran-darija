{"n":96,"verses":[{"n":1,"ar":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","fr":"Lis, au nom de ton Seigneur qui a créé,","juz":30,"q":239,"page":597,"sajda":0},{"n":2,"ar":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","fr":"qui a créé l'homme d'une adhérence.","juz":30,"q":239,"page":597,"sajda":0},{"n":3,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","fr":"Lis! Ton Seigneur est le Très Noble,","juz":30,"q":239,"page":597,"sajda":0},{"n":4,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","fr":"qui a enseigné par la plume [le calame],","juz":30,"q":239,"page":597,"sajda":0},{"n":5,"ar":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","fr":"a enseigné à l'homme ce qu'il ne savait pas.","juz":30,"q":239,"page":597,"sajda":0},{"n":6,"ar":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","fr":"Prenez-garde! Vraiment l'homme devient rebelle,","juz":30,"q":239,"page":597,"sajda":0},{"n":7,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","fr":"dès qu'il estime qu'il peut se suffire à lui-même (à cause de sa richesse).","juz":30,"q":239,"page":597,"sajda":0},{"n":8,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","fr":"Mais, c'est vers ton Seigneur qu'est le retour.","juz":30,"q":239,"page":597,"sajda":0},{"n":9,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","fr":"As-tu vu celui qui interdit","juz":30,"q":239,"page":597,"sajda":0},{"n":10,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","fr":"à un serviteur d'Allah [Muhammad] de célébrer la Salât?","juz":30,"q":239,"page":597,"sajda":0},{"n":11,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","fr":"Vois-tu s'il est sur la bonne voie,","juz":30,"q":239,"page":597,"sajda":0},{"n":12,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","fr":"ou s'il ordonne la piété?","juz":30,"q":239,"page":597,"sajda":0},{"n":13,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","fr":"Vois-tu s'il dément et tourne le dos?","juz":30,"q":239,"page":597,"sajda":0},{"n":14,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","fr":"Ne sait-il pas que vraiment Allah voit?","juz":30,"q":239,"page":597,"sajda":0},{"n":15,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","fr":"Mais non! S'il ne cesse pas, Nous le saisirons certes, par le toupet,","juz":30,"q":239,"page":597,"sajda":0},{"n":16,"ar":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","fr":"le toupet d'un menteur, d'un pécheur.","juz":30,"q":239,"page":597,"sajda":0},{"n":17,"ar":"فَلْيَدْعُ نَادِيَهُۥ","fr":"Qu'il appelle donc son assemblée.","juz":30,"q":239,"page":597,"sajda":0},{"n":18,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","fr":"Nous appellerons les gardiens [de l'Enfer].","juz":30,"q":239,"page":597,"sajda":0},{"n":19,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","fr":"Non! Ne lui obéis pas; mais prosterne-toi et rapproche-toi.","juz":30,"q":239,"page":597,"sajda":1}]}