{"n":108,"verses":[{"n":1,"ar":"إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","fr":"Nous t'avons certes, accordé l'Abondance.","juz":30,"q":240,"page":602,"sajda":0},{"n":2,"ar":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","fr":"Accomplis la Salât pour ton Seigneur et sacrifie.","juz":30,"q":240,"page":602,"sajda":0},{"n":3,"ar":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","fr":"Celui qui te hait sera certes, sans postérité.","juz":30,"q":240,"page":602,"sajda":0}]}