{"n":112,"verses":[{"n":1,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","fr":"Dis: «Il est Allah, Unique.","juz":30,"q":240,"page":604,"sajda":0},{"n":2,"ar":"ٱللَّهُ ٱلصَّمَدُ","fr":"Allah, Le Seul à être imploré pour ce que nous désirons.","juz":30,"q":240,"page":604,"sajda":0},{"n":3,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","fr":"Il n'a jamais engendré, n'a pas été engendré non plus.","juz":30,"q":240,"page":604,"sajda":0},{"n":4,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","fr":"Et nul n'est égal à Lui».","juz":30,"q":240,"page":604,"sajda":0}]}