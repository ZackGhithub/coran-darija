{"n":104,"verses":[{"n":1,"ar":"وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ","fr":"Malheur à tout calomniateur diffamateur,","juz":30,"q":240,"page":601,"sajda":0},{"n":2,"ar":"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ","fr":"qui amasse une fortune et la compte,","juz":30,"q":240,"page":601,"sajda":0},{"n":3,"ar":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","fr":"pensant que sa fortune l'immortalisera.","juz":30,"q":240,"page":601,"sajda":0},{"n":4,"ar":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","fr":"Mais non! Il sera certes, jeté dans la Hutamah.","juz":30,"q":240,"page":601,"sajda":0},{"n":5,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","fr":"Et qui te dira ce qu'est la Hutamah?","juz":30,"q":240,"page":601,"sajda":0},{"n":6,"ar":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","fr":"Le Feu attisé d'Allah","juz":30,"q":240,"page":601,"sajda":0},{"n":7,"ar":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","fr":"qui monte jusqu'aux cœurs.","juz":30,"q":240,"page":601,"sajda":0},{"n":8,"ar":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ","fr":"Il se refermera sur eux,","juz":30,"q":240,"page":601,"sajda":0},{"n":9,"ar":"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ","fr":"en colonnes (de flammes) étendues.","juz":30,"q":240,"page":601,"sajda":0}]}