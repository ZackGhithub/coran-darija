{"n":102,"verses":[{"n":1,"ar":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","fr":"La course aux richesses vous distrait,","juz":30,"q":240,"page":600,"sajda":0},{"n":2,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","fr":"jusqu'à ce que vous visitiez les tombes.","juz":30,"q":240,"page":600,"sajda":0},{"n":3,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","fr":"Mais non! Vous saurez bientôt!","juz":30,"q":240,"page":600,"sajda":0},{"n":4,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","fr":"(Encore une fois)! Vous saurez bientôt!","juz":30,"q":240,"page":600,"sajda":0},{"n":5,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","fr":"Sûrement! Si vous saviez de science certaine.","juz":30,"q":240,"page":600,"sajda":0},{"n":6,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","fr":"Vous verrez, certes, la Fournaise.","juz":30,"q":240,"page":600,"sajda":0},{"n":7,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","fr":"Puis, vous la verrez certes, avec l'œil de la certitude.","juz":30,"q":240,"page":600,"sajda":0},{"n":8,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","fr":"Puis, assurément, vous serez interrogés, ce jour-là, sur les délices.","juz":30,"q":240,"page":600,"sajda":0}]}