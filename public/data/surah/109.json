{"n":109,"verses":[{"n":1,"ar":"قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ","fr":"Dis: «O vous les infidèles!","juz":30,"q":240,"page":603,"sajda":0},{"n":2,"ar":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","fr":"Je n'adore pas ce que vous adorez.","juz":30,"q":240,"page":603,"sajda":0},{"n":3,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","fr":"Et vous n'êtes pas adorateurs de ce que j'adore.","juz":30,"q":240,"page":603,"sajda":0},{"n":4,"ar":"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ","fr":"Je ne suis pas adorateur de ce que vous adorez.","juz":30,"q":240,"page":603,"sajda":0},{"n":5,"ar":"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ","fr":"Et vous n'êtes pas adorateurs de ce que j'adore.","juz":30,"q":240,"page":603,"sajda":0},{"n":6,"ar":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","fr":"A vous votre religion, et à moi ma religion».","juz":30,"q":240,"page":603,"sajda":0}]}