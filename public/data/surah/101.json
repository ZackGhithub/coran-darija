{"n":101,"verses":[{"n":1,"ar":"ٱلْقَارِعَةُ","fr":"Le fracas!","juz":30,"q":240,"page":600,"sajda":0},{"n":2,"ar":"مَا ٱلْقَارِعَةُ","fr":"Qu'est-ce que le fracas?","juz":30,"q":240,"page":600,"sajda":0},{"n":3,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","fr":"Et qui te dira ce qu'est le fracas?","juz":30,"q":240,"page":600,"sajda":0},{"n":4,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","fr":"C'est le jour où les gens seront comme des papillons éparpillés,","juz":30,"q":240,"page":600,"sajda":0},{"n":5,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","fr":"et les montagnes comme de la laine cardée;","juz":30,"q":240,"page":600,"sajda":0},{"n":6,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","fr":"quant à celui dont la balance sera lourde","juz":30,"q":240,"page":600,"sajda":0},{"n":7,"ar":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","fr":"il sera dans une vie agréable;","juz":30,"q":240,"page":600,"sajda":0},{"n":8,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","fr":"et quant à celui dont la balance sera légère,","juz":30,"q":240,"page":600,"sajda":0},{"n":9,"ar":"فَأُمُّهُۥ هَاوِيَةٌۭ","fr":"sa mère [destination] est un abîme très profond.","juz":30,"q":240,"page":600,"sajda":0},{"n":10,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","fr":"Et qui te dira ce que c'est?","juz":30,"q":240,"page":600,"sajda":0},{"n":11,"ar":"نَارٌ حَامِيَةٌۢ","fr":"C'est un Feu ardent.","juz":30,"q":240,"page":600,"sajda":0}]}