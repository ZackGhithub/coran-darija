{"n":94,"verses":[{"n":1,"ar":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","fr":"N'avons-Nous pas ouvert pour toi ta poitrine?","juz":30,"q":239,"page":596,"sajda":0},{"n":2,"ar":"وَوَضَعْنَا عَنكَ وِزْرَكَ","fr":"Et ne t'avons-Nous pas déchargé du fardeau","juz":30,"q":239,"page":596,"sajda":0},{"n":3,"ar":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","fr":"qui accablait ton dos?","juz":30,"q":239,"page":596,"sajda":0},{"n":4,"ar":"وَرَفَعْنَا لَكَ ذِكْرَكَ","fr":"Et exalté pour toi ta renommée?","juz":30,"q":239,"page":596,"sajda":0},{"n":5,"ar":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","fr":"A côté de la difficulté est, certes, une facilité!","juz":30,"q":239,"page":596,"sajda":0},{"n":6,"ar":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا","fr":"A côté de la difficulté est, certes, une facilité!","juz":30,"q":239,"page":596,"sajda":0},{"n":7,"ar":"فَإِذَا فَرَغْتَ فَٱنصَبْ","fr":"Quand tu te libères, donc, lève-toi,","juz":30,"q":239,"page":596,"sajda":0},{"n":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","fr":"et à ton Seigneur aspire.","juz":30,"q":239,"page":596,"sajda":0}]}